    "modern-minimalist": {
      "id": "modern-minimalist",
      "name": "Modern Minimalist",
      "tagline": "Less is more — and it looks stunning.",
      "description": "You gravitate toward clean lines, neutral palettes, and spaces that breathe. Every piece in your home has a purpose, and clutter is your nemesis. You appreciate quality over quantity and believe a well-designed room needs fewer elements, not more.",
